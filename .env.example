# ThrottleHAWK backend configuration
# Copy this file to .env and adjust values for your environment.

# Port the Express + WebSocket server listens on
PORT=4000

# Redis connection string (ioredis format)
# Examples:
#   redis://127.0.0.1:6379
#   redis://:password@redis-host:6379/0
#   rediss://user:password@redis-host:6380  (TLS)
REDIS_URL=redis://127.0.0.1:6379

# Sliding window size, in milliseconds
RATE_LIMIT_WINDOW_MS=30000

# Max requests allowed per client within the window
RATE_LIMIT_MAX_REQUESTS=10
